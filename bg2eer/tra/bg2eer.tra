@15618 = ~Хулрик~
@15619 = ~Фаербид Эльфоподобный~
@15620 = ~Ллинделлин~
@15621 = ~Аркион~
@15622 = ~Немфр~
@15623 = ~Ордулиниан~
@15624 = ~Короткий меч Пердью~
@15625 = ~Килор~
@15626 = ~Норали~
@15627 = ~Короткий меч Пердью~
@15628 = ~~
@15629 = ~Велт~
@15630 = ~Фейркас~
@15631 = ~Алгернон~
@15632 = ~Квинн~
