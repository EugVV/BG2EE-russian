@73037 = ~~
@73038 = ~А-а-а-а! Бежим!~ [SARMAN06]
@73039 = ~Преклони колени и, ВОЗМОЖНО, выживешь.~ [BAZDRA01]
@73040 = ~Пади предо мной!~ [BAZDRA02]
@73041 = ~Умрите, захватчики!~ [BAZDRA03]
@73042 = ~~ [BAZDRA04]
@73043 = ~~ [BAZDRA05]
@73044 = ~Ничего ещё не кончено!~ [BAZDRA06]
@73045 = ~~
@73046 = ~~
@73047 = ~~
@73048 = ~~
@73049 = ~~
@73050 = ~А-а-а-а! Бежим!~ [SARFEM06]
@73051 = ~Сам-то как думаешь, что мы делаем? Готовимся к войне! Теперь оставь нас в покое и исчезни!~ ~Сама-то как думаешь, что мы делаем? Готовимся к войне! Теперь оставь нас в покое и исчезни!~
@73052 = ~Мне просто стало интересно, что вы делаете.~
@73053 = ~К войне? Против кого?~
@73054 = ~Ладно, я оставлю тебя в покое.~
@73055 = ~Как я, по-твоему, выгляжу, как офицер? Или как клерк? У нас будут самые серьёзные противники… дроу, пожиратели разума, драконы и всё в том же духе!~
@73056 = ~Подойди поближе.~ [GORBAT01]
@73057 = ~~ [GORBAT02]
@73058 = ~~ [GORBAT03]
@73059 = ~~ [GORBAT04]
@73060 = ~~ [GORBAT05]
@73061 = ~~ [GORBAT06]
@73062 = ~Приветствую тебя! Как дела?~ [GORCAM01]
@73063 = ~Ты сам на себя накликал!~ [GORCAM02] ~Ты сама на себя накликала!~ [GORCAM02]
@73064 = ~О, чепуха.~ [GORCAM03]
@73065 = ~~ [GORCAM04]
@73066 = ~Ар-рх-х… Назад на планы, полагаю…~ [GORCAM05]
@73067 = ~~ [GORDRA01]
@73068 = ~~ [GORDRA02]
@73069 = ~Умрите, ничтожные насекомые!~ [GORDRA03]
