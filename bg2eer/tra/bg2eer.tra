@73091 = ~Беги, пока можешь!~ [1GROMG01]
@73092 = ~За Громнира!~ [1GROMG02]
@73093 = ~~ [1GROMG03]
@73094 = ~~ [1GROMG04]
@73095 = ~Я поражён!~ [1GROMG05]
@73096 = ~~
@73097 = ~Попробуй жало дроу!~ [SENPRI02]
@73098 = ~За Паучью Королеву!~ [SENPRI03]
@73099 = ~Этот водоём никуда не ведёт.~
@73100 = ~~ [SENPIR04]
@73101 = ~~ [SENPRI05]
@73102 = ~Назад! Назад!~ [SENPRI06]
@73103 = ~~
@73104 = ~Познай ярость Баала!~ [SENDAI02]
@73105 = ~Моя магия тебя сокрушит!~ [SENDAI03]
@73106 = ~~ [SENDAI04]
@73107 = ~~ [SENDAI05]
@73108 = ~Ты не узнаешь вкус моей крови!~ [SENDAI06]
@73109 = ~Убить захватчиков!~ [2GROMG01]
@73110 = ~За Громнира!~ [2GROMG02]
@73111 = ~~ [2GROMG03]
@73112 = ~~ [2GROMG04]
@73113 = ~Бежим! БЕЖИМ!~ [2GROMG05]
@73114 = ~Чего тебе надо от Громнира?~ [GROM01]
@73115 = ~Какое веселье! ХА!~ [GROM02]
@73116 = ~Глупо связываться со мной!~ [GROM03]
@73117 = ~~ [GROM04]
@73118 = ~Н-не… невозможно…~ [GROM05]
@73119 = ~Громнир здесь не останется!~ [GROM06]
@73120 = ~Тебя разбудили монстры! Возможно, отдых в карманном плане будет безопаснее.~
@73121 = ~Я здесь.~ [SOLAR01]
@73122 = ~Я одержу победу!~ [SOLAR02]
@73123 = ~Свет снизойдёт предо мной!~ [SOLAR03]
@73124 = ~~ [SOLAR04]
@73125 = ~~ [SOLAR05]
@73126 = ~Ты не встанешь у меня на дороге.~ [ILLASE01]
@73127 = ~Умрите, тупицы!~ [ILLASE02]
@73128 = ~Красные убийцы!~ [ILLASE03]
@73129 = ~~ [ILLASE04]
@73130 = ~~ [ILLASE05]
@73131 = ~Они слишком сильны! Отступаем!~ [ILLASE06]
@73132 = ~Причудливое магическое оборудование в беспорядке разбросано на столе среди вырванных глаз всевозможных существ.~
@73133 = ~~
@73134 = ~~
@73135 = ~~
@73136 = ~~
@73137 = ~~
@73138 = ~~
@73139 = ~Случайность: приведена в действие~
@73140 = ~Что такое?~ [SARKIS01]
@73141 = ~Мой клинок порежет тебя на лоскуты!~ [SARKIS02]
@73142 = ~Беги или умри!~ [SARKIS03]
@73143 = ~~ [SARKIS04]
@73144 = ~~ [SARKIS05]
@73145 = ~Мне нужно бежать!~ [SARKIS06]
@73146 = ~На нас напали!~
@73147 = ~~
@73148 = ~Во имя чести!~ [SARMAT02]
@73149 = ~~
@73150 = ~Пощадите!~
@73151 = ~~ [SARMAT04]
@73152 = ~~ [SARMAT05]
@73153 = ~Мне нужно бежать!~ [SARMAT06]
@73154 = ~С-спасибо, спасибо тебе, добрый господин! Похоже, честный купец не может нынче даже проехать по Тетиру, не нарвавшись на войска или бандитов!~ ~С-спасибо, спасибо тебе, добрая госпожа! Похоже, честный купец не может нынче даже проехать по Тетиру, не нарвавшись на войска или бандитов!~
@73155 = ~Рад был помочь.~ ~Рада была помочь.~
@73156 = ~Возможно, за помощь в затруднении была бы уместна награда?..~
@73157 = ~Ну, после того, как я тебя убью и заберу себе золото, тебя это уже не будет так сильно беспокоить.~
@73158 = ~Чт-то? Айи-и-и! Опять бандиты! Храни меня Вокин!~
@73159 = ~Да, разумеется. Хотелось бы мне дать больше, но мой караван уничтожен почти полностью… боюсь, придётся на некоторое время отойти от дел. Но это всё же куда лучше, чем смерть. Надеюсь, столько хватит…~
@73160 = ~Вот, возьми эти деньги в знак моей благодарности. Мой караван уничтожен, я в отчаянном положении… но это всё же куда лучше, чем смерть. И у меня по-прежнему осталась большая часть моих товаров, в конце концов.~
@73161 = ~Фокус в том, что теперь придётся дожидаться прибытия моего следующего каравана, а потом уже грузить на него весь товар. Однако это будет через несколько дней. Если хочешь купить что-нибудь, пока он не прибыл, я с радостью продам со скидкой.~
@73162 = ~Ты ничего не знаешь об общине огненных великанов неподалёку?~
@73163 = ~Нет, боюсь, нет. Я избегаю приближаться к горам. Возможно, я бы рискнул отправиться через болото, даже если там есть духи… но только не туда.~
@73164 = ~А о болоте ты что-нибудь знаешь?~
@73165 = ~Да?~ [MELISS01]
@73166 = ~Погибель ждёт тебя!~ [MELISS02]
@73167 = ~Ты будешь страдать!~ [MELISS03]
@73168 = ~~ [MELISS04]
@73169 = ~~ [MELISS05]
@73170 = ~Мне нужно бежать!~ [MELISS06]
@73171 = ~Разве я мало страдала?~ [SARCNT01]
@73172 = ~Стража, ко мне!~ [SARCNT02]
@73173 = ~~ [SARCNT03]
@73174 = ~~ [SARCNT04]
@73175 = ~~ [SARCNT05]
@73176 = ~Кто-нибудь, на помощь! Пожалуйста!~ [SARCNT06]
@73177 = ~У меня и поважнее этого дела найдутся.~ [1AMONK01]
@73178 = ~Этот гнев я обрушу на своих врагов!~ [1AMONK02]
@73179 = ~Попробуй-ка на вкус мой кулак!~ [1AMONK03]
@73180 = ~~ [1AMONK04]
@73181 = ~~ [1AMONK05]
@73182 = ~Нет ничего позорного в отступлении.~ [1AMONK06]
@73183 = ~~ [3AMONK01]
@73184 = ~Я сорву свой гнев на моих врагов!~ [3AMONK02]
@73185 = ~Попробуй-ка на вкус мой кулак!~ [3AMONK03]
@73186 = ~~ [3AMONK04]
@73187 = ~~ [3AMONK05]
@73188 = ~Возвращаемся в монастырь!~ [3AMONK06]
@73189 = ~У меня и поважнее этого дела найдутся.~ [2AMONK01]
@73190 = ~Я сорву свой гнев на моих врагов!~ [2AMONK02]
@73191 = ~Враги монастыря должны погибнуть!~ [2AMONK03]
@73192 = ~~ [2AMONK04]
@73193 = ~~ [2AMONK05]
@73194 = ~Возвращаемся в монастырь!~ [2AMONK06]
@73195 = ~~
