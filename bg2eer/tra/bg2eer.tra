@60794 = ~Тиакс будет править миром! Вот увидите…~ [PPTIAX01]
@60795 = ~Тиакс тебя сметёт!~ [PPTIAX03]
@60796 = ~~ [PPTIAX04]
@60797 = ~~ [PPTIAX05]
@60798 = ~М-м?~ [TOGAL01]
@60799 = ~Ты умрёшь! А мы пожрём!~ [TOGAL04]
@60800 = ~~ [TOGAL05]
@60801 = ~~ [TOGAL06]
@60802 = ~~ [TOGAL07]
@60803 = ~Я действую ради общего блага.~ [SAHPR201]
@60804 = ~Смерть всем, кто на моём пути!~ [SAHPR203]
@60805 = ~Изгнанники должны жить!~ [SAHPR204]
@60806 = ~~ [SAHPR205]
@60807 = ~~ [SAHPR206]
